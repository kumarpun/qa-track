# MySQL-compatible database (MySQL 8 / TiDB). Never commit the real .env.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=qa_platform
# Set to true for TLS connections (TiDB Cloud, RDS, PlanetScale...)
DB_SSL=false

# Separate database used by automated tests (created/migrated by the test setup). Must differ from DB_NAME.
TEST_DB_NAME=qa_platform_test

# Session signing key: generate with `openssl rand -hex 32`
AUTH_SECRET=replace-with-64-hex-chars

# Where uploaded attachments are stored (relative to project root, or absolute)
UPLOAD_DIR=./uploads

# "Run in browser" on a test case opens a real Chromium window on the machine running this server and visits
# the URLs written in the case steps. Local use only; leave unset anywhere else. Needs `npx playwright install chromium`.
ENABLE_BROWSER_RUNS=0
# Browser runs only visit public web pages: localhost, private networks, cloud metadata and DB_HOST are blocked.
# Set to 1 only to test a site on your own machine/network (metadata addresses and DB_HOST stay blocked).
BROWSER_RUNS_ALLOW_PRIVATE=0

# Comment images are uploaded to freeimage.host (https://freeimage.host/api); images there are public.
FREEIMAGE_API_KEY=

# Local runner (npm run runner): origins of the hosted app allowed to drive this machine's browser (comma separated)
RUNNER_ALLOWED_ORIGINS=
